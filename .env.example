# AlgoBloom Root Docker Compose Environment Template
# Copy to `.env` for local development (`cp .env.example .env`).
# NEVER commit `.env` with real secrets or API keys.

# PostgreSQL (SOLE owner: services/gateway)
POSTGRES_DB=algobloom
POSTGRES_USER=algobloom
POSTGRES_PASSWORD=algobloom_dev_password
POSTGRES_PORT=5432

# Redis 7 (Streams broker + Gateway internal refresh token TTL store)
REDIS_PORT=6379

# Core Gateway
GATEWAY_PORT=8000
SWAGGER_PORT=8080
JWT_SECRET=change-me-local-jwt-secret
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=604800

# Internal AI Service Boundary (X-Internal-API-Key)
INTERNAL_API_KEY=change-me-shared-internal-api-key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MOCK_AI=true
MAX_RETRIES=3
BASE_BACKOFF_MS=1000
