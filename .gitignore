# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.html
coverage.txt
coverage.xml
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# =====================================================================
# AlgoBloom Monorepo Additions (Python, Node/React, Env, Docker, IDE/OS)
# =====================================================================

# Environment & Secrets
.env.*
!.env.example
*.local

# Python (AI Service & Test Generators)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Node / React (Frontend SPA)
node_modules/
frontend/dist/
frontend/build/
frontend/.next/
.npm/
.yarn/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Docker Volumes & Local Runtime Data
data/
volumes/
pgdata/
redisdata/
/data/problems/

# IDE & OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Local AI Agent Context (Never commit)
GEMINI.md
